{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "dtoFileNameSuffix": [".input-dto.ts", ".view-dto.ts"],
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": [
      { "include": "**/env/*", "watchAssets": true }
    ]
  }
}
